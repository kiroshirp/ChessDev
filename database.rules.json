{
  "rules": {
    ".read": "auth != null && auth.uid === 'chessdev-admin'",
    ".write": "auth != null && auth.uid === 'chessdev-admin' && newData.hasChildren(['catalog'])",
    "catalog": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'chessdev-admin' && newData.exists()",
      ".validate": "newData.hasChildren(['revision', 'products']) && newData.child('revision').isNumber() && newData.child('revision').val() % 1 === 0 && ((!data.exists() && newData.child('revision').val() === 1) || newData.child('revision').val() === data.child('revision').val() + 1) && (newData.parent().child('managementRevision').val() === (data.parent().child('managementRevision').exists() ? data.parent().child('managementRevision').val() + 1 : 1))",
      "revision": {
        ".validate": "newData.isNumber() && newData.val() > 0"
      },
      "products": {
        ".validate": "newData.hasChildren()",
        "$id": {
          ".validate": "$id.matches(/^(boards|pieces|dgt|leap|folding|mural|giant|item-(0[0-9]|[1-8][0-9]|9[0-2]))$/) && newData.hasChildren(['id','name','plural','price','max','kind','description','review','visible','position','replacementValue']) && newData.child('id').val() === $id",

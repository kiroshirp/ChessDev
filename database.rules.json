          "price": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && ((newData.val() * 100) % 1 < 0.000001 || (newData.val() * 100) % 1 > 0.999999)"
          },
          "replacementValue": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && ((newData.val() * 100) % 1 < 0.000001 || (newData.val() * 100) % 1 > 0.999999)"
          },
          "max": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && newData.val() % 1 === 0"
          },
          "position": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && newData.val() % 1 === 0"
          },
          "kind": {
            ".validate": "newData.isString() && (newData.val() === 'board' || newData.val() === 'pieces' || newData.val() === 'clock' || newData.val() === 'folding' || newData.val() === 'mural' || newData.val() === 'giant')"
          },

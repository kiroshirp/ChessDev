          },
          "visible": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "$other": {
      ".validate": false
    },
    ".validate": "newData.hasChildren(['catalog'])",

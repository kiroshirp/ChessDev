            ".validate": "newData.isString() && newData.val() === $id"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && newData.val().matches(/.*[^\\s].*/)"
          },
          "plural": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && newData.val().matches(/.*[^\\s].*/)"
          },
          "description": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 400 && newData.val().matches(/.*[^\\s].*/)"

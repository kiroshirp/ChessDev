            ".validate": "newData.hasChildren([\"name\",\"quantity\",\"unitPrice\",\"replacementValue\"]) && ($pid.matches(/^(boards|pieces|dgt|leap|folding|mural|giant|item-(0[0-9]|[1-8][0-9]|9[0-2]))$/) && (data.exists() || (root.child('catalog/products').child($pid).child('visible').val() === true && newData.child('quantity').val() <= root.child('catalog/products').child($pid).child('max').val() && newData.child('unitPrice').val() === root.child('catalog/products').child($pid).child('price').val() && newData.child('replacementValue').val() === root.child('catalog/products').child($pid).child('replacementValue').val() && newData.child('name').val() === root.child('catalog/products').child($pid).child('name').val())))",

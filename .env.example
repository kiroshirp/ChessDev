API_PORT=3001
WORLD_PORT=2567
HOST=127.0.0.1
FRONTEND_URL=http://127.0.0.1:5173/
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174
# Lichess OAuth uses PKCE; no application registration or client secret.
LICHESS_CLIENT_ID=chessdev
LICHESS_REDIRECT_URI=http://127.0.0.1:3001/auth/lichess/callback
# Node adapters use .local/pixelspace.sqlite; development identities only on loopback.
# Public deployments: WORLD_SECRET and INTERNAL_SECRET are distinct 32+ character
# secrets shared between Worker and Colyseus. Never place them in VITE_* variables.

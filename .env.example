API_PORT=3001
WORLD_PORT=2567
HOST=127.0.0.1
FRONTEND_URL=http://127.0.0.1:5173/
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174
# Node adapters default to .local/pixelspace.sqlite and local-only development identities.
# To test real Discord locally, create an application and register this callback:
# DISCORD_REDIRECT_URI=http://127.0.0.1:3001/auth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Public deployment: set secrets with Wrangler, never VITE_*.
# API_URL=http://127.0.0.1:3001
# WORLD_SECRET= (32+ random characters; same value in API and world gateway)
# INTERNAL_SECRET= (different 32+ random characters; same value in API and Colyseus)

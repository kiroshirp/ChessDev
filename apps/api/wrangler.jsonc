{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pixelspace-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-18",
  "vars": {
    "ENVIRONMENT": "production",
    "LICHESS_CLIENT_ID": "chessdev",
    "LICHESS_REDIRECT_URI": "https://kiroshirp.github.io/ChessDev/",
    "FRONTEND_URL": "https://kiroshirp.github.io/ChessDev/",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixelspace",
      "database_id": "55457fe3-9dc9-4b2d-9282-e029ed09c16d",
      "migrations_dir": "../../packages/database/d1-migrations",
    },
  ],
  "triggers": { "crons": ["0 3 * * *"] },
}
